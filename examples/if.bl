true if
	'Working!' println
fi


false if
	'Not working!' println
else
	'Working!' println
fi


false if
	'Not working!' println
MrBeast! true elif
	'Working!' println
fi


false if
	'Not working!' println
MrBeast! false elif
	'Not working!' println
else
	'Working!' println
fi


false if
	false if
		'Not working!' println
	else
		'Not working!' println
	fi
	'Not working!' println
MrBeast! false elif
	'Not working!' println
else
	'Working!' println
fi
